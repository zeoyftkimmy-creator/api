//==================================================================//
// ON TICK
//==================================================================//

void OnTick()
{
   //===============================================================
   // CEK API
   //===============================================================

   CheckApiStatus();


   //===============================================================
   // KELOLA POSISI YANG SEDANG RUNNING
   // Tetap dikelola walaupun Bot STOP
   //===============================================================

   if(
      CountOpenPositions() > 0
   )
   {
      ManageTrade();
   }


   //===============================================================
   // KALAU BOT STOP
   // Jangan entry baru
   //===============================================================

   if(!BotEnabled)
   {
      return;
   }


   //===============================================================
   // ENTRY HANYA PADA BAR M5 BARU
   //===============================================================

   if(!IsNewEntryBar())
   {
      return;
   }


   //===============================================================
   // HANYA 1 POSISI
   //===============================================================

   if(
      CountOpenPositions() > 0
   )
   {
      return;
   }


   //===============================================================
   // CARI SWING M30
   //===============================================================

   double swingHigh = 0;

   double swingLow = 0;

   datetime highTime = 0;

   datetime lowTime = 0;


   ZoneTrend trend =
      GetSwingTrend(
         swingHigh,
         swingLow,
         highTime,
         lowTime
      );


   if(
      trend ==
      TREND_NONE
   )
   {
      return;
   }


   //===============================================================
   // HITUNG ZONE 1
   //===============================================================

   double zone1Low = 0;

   double zone1High = 0;


   GetZone(
      trend,
      swingHigh,
      swingLow,
      Zone1Start,
      Zone1End,
      zone1Low,
      zone1High
   );


   //===============================================================
   // HITUNG ZONE 2
   //===============================================================

   double zone2Low = 0;

   double zone2High = 0;


   GetZone(
      trend,
      swingHigh,
      swingLow,
      Zone2Start,
      Zone2End,
      zone2Low,
      zone2High
   );


   //===============================================================
   // HARGA SEKARANG
   //===============================================================

   double price =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );


   //===============================================================
   // CEK ZONE
   //===============================================================

   bool inZone1 =
      PriceInZone(
         price,
         zone1Low,
         zone1High
      );


   bool inZone2 =
      PriceInZone(
         price,
         zone2Low,
         zone2High
      );


   //===============================================================
   // ZONE AKTIF
   //
   // Jika sudah masuk Zone 2:
   // gunakan Zone 2.
   //
   // Kalau baru di Zone 1:
   // gunakan Zone 1.
   //===============================================================

   double activeZoneLow = 0;

   double activeZoneHigh = 0;


   bool validZone = false;


   if(inZone2)
   {
      activeZoneLow =
         zone2Low;


      activeZoneHigh =
         zone2High;


      validZone = true;


      Print(
         "Harga berada di ZONE 2."
      );
   }
   else
   if(inZone1)
   {
      activeZoneLow =
         zone1Low;


      activeZoneHigh =
         zone1High;


      validZone = true;


      Print(
         "Harga berada di ZONE 1."
      );
   }


   if(!validZone)
   {
      return;
   }


   //===============================================================
   // BUY
   //===============================================================

   if(
      trend ==
      TREND_UP
   )
   {
      datetime rejectionTime = 0;


      bool rejection =
         CheckRejectionM15(
            true,
            activeZoneLow,
            activeZoneHigh,
            rejectionTime
         );


      if(!rejection)
      {
         return;
      }


      // Jangan gunakan candle rejection yang sama berkali-kali
      if(
         rejectionTime ==
         LastRejectionBar
      )
      {
         return;
      }


      LastRejectionBar =
         rejectionTime;


      Print(
         "================================"
      );


      Print(
         "BUY REJECTION VALID"
      );


      Print(
         "TF = M15"
      );


      Print(
         "Price = ",
         price
      );


      Print(
         "Zone Low = ",
         activeZoneLow
      );


      Print(
         "Zone High = ",
         activeZoneHigh
      );


      Print(
         "================================"
      );


      OpenBuy(
         swingHigh,
         swingLow
      );


      return;
   }


   //===============================================================
   // SELL
   //===============================================================

   if(
      trend ==
      TREND_DOWN
   )
   {
      datetime rejectionTime = 0;


      bool rejection =
         CheckRejectionM15(
            false,
            activeZoneLow,
            activeZoneHigh,
            rejectionTime
         );


      if(!rejection)
      {
         return;
      }


      // Jangan gunakan candle rejection yang sama berkali-kali
      if(
         rejectionTime ==
         LastRejectionBar
      )
      {
         return;
      }


      LastRejectionBar =
         rejectionTime;


      Print(
         "================================"
      );


      Print(
         "SELL REJECTION VALID"
      );


      Print(
         "TF = M15"
      );


      Print(
         "Price = ",
         price
      );


      Print(
         "Zone Low = ",
         activeZoneLow
      );


      Print(
         "Zone High = ",
         activeZoneHigh
      );


      Print(
         "================================"
      );


      OpenSell(
         swingHigh,
         swingLow
      );


      return;
   }
}


