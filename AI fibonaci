void OpenBuy(
   double swingHigh,
   double swingLow
)
{
   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK
      );


   //===============================================================
   // SL = SWING LOW M30
   //===============================================================

   double sl =
      NormalizeDouble(
         swingLow - SLBufferUSD,
         _Digits
      );


   //===============================================================
   // TP1 = FIB 0
   //===============================================================

   double tp1 =
      FibPrice(
         TREND_UP,
         swingHigh,
         swingLow,
         TP1Level
      );


   //===============================================================
   // TP2 = FIB -0.272
   //===============================================================

   double tp2 =
      FibPrice(
         TREND_UP,
         swingHigh,
         swingLow,
         TP2Level
      );


   if(
      !IsValidSLDistance(
         ORDER_TYPE_BUY,
         sl
      )
   )
   {
      Print(
         "BUY dibatalkan: SL tidak valid."
      );

      return;
   }


   if(tp2 <= tp1)
   {
      Print(
         "BUY dibatalkan: TP2 salah."
      );

      return;
   }


   //===============================================================
   // REQUEST
   //===============================================================

   MqlTradeRequest request;

   MqlTradeResult result;


   ZeroMemory(request);

   ZeroMemory(result);


   request.action =
      TRADE_ACTION_DEAL;


   request.symbol =
      _Symbol;


   request.volume =
      LotSize;


   request.type =
      ORDER_TYPE_BUY;


   request.price =
      ask;


   // TP dikelola EA
   request.tp = 0;


   request.sl =
      sl;


   request.deviation =
      Slippage;


   request.magic =
      MagicNumber;


   request.comment =
      "Fibo-BUY";


   request.type_filling =
      GetFillingMode();


   ResetLastError();


   if(
      !OrderSend(
         request,
         result
      )
   )
   {
      Print(
         "BUY gagal | Error = ",
         GetLastError()
      );

      return;
   }


   if(
      result.retcode !=
      TRADE_RETCODE_DONE &&
      result.retcode !=
      TRADE_RETCODE_PLACED
   )
   {
      Print(
         "BUY ditolak broker | Retcode = ",
         result.retcode
      );

      return;
   }


   //===============================================================
   // SIMPAN DATA TRADE
   //===============================================================

   ActiveTrade.valid = true;

   ActiveTrade.direction =
      POSITION_TYPE_BUY;


   ActiveTrade.swingHigh =
      swingHigh;


   ActiveTrade.swingLow =
      swingLow;


   ActiveTrade.tp1 =
      tp1;


   ActiveTrade.tp2 =
      tp2;


   ActiveTrade.initialSL =
      sl;


   ActiveTrade.tp1Reached =
      false;


   Print(
      "================================"
   );

   Print(
      "BUY OPEN"
   );

   Print(
      "Entry = ",
      ask
   );

   Print(
      "Swing High = ",
      swingHigh
   );

   Print(
      "Swing Low = ",
      swingLow
   );

   Print(
      "SL = ",
      sl
   );

   Print(
      "TP1 Fib 0 = ",
      tp1
   );

   Print(
      "TP2 Fib -0.272 = ",
      tp2
   );

   Print(
      "================================"
   );
