//==================================================================//
// CEK BAR M5 BARU
//==================================================================//

bool IsNewEntryBar()
{
   datetime currentBar =
      iTime(
         _Symbol,
         EntryTF,
         0
      );

   if(currentBar <= 0)
      return false;


   if(currentBar != LastEntryBar)
   {
      LastEntryBar = currentBar;

      return true;
   }

   return false;
}


//==================================================================//
// HITUNG POSISI MILIK EA
//==================================================================//

int CountOpenPositions()
{
   int count = 0;


   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;


      if(!PositionSelectByTicket(ticket))
         continue;


      if(
         PositionGetString(POSITION_SYMBOL)
         != _Symbol
      )
         continue;


      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         )
         != MagicNumber
      )
         continue;


      count++;
   }


   return count;
}


//==================================================================//
// CARI SWING HIGH / LOW M30
//==================================================================//

ZoneTrend GetSwingTrend(
   double &swingHigh,
   double &swingLow,
   datetime &highTime,
   datetime &lowTime
)
{
   int highIndex =
      iHighest(
         _Symbol,
         SwingTF,
         MODE_HIGH,
         SwingLookback,
         1
      );


   int lowIndex =
      iLowest(
         _Symbol,
         SwingTF,
         MODE_LOW,
         SwingLookback,
         1
      );


   if(
      highIndex < 0 ||
      lowIndex < 0
   )
   {
      return TREND_NONE;
   }


   swingHigh =
      iHigh(
         _Symbol,
         SwingTF,
         highIndex
      );


   swingLow =
      iLow(
         _Symbol,
         SwingTF,
         lowIndex
      );


   highTime =
      iTime(
         _Symbol,
         SwingTF,
         highIndex
      );


   lowTime =
      iTime(
         _Symbol,
         SwingTF,
         lowIndex
      );


   if(swingHigh <= swingLow)
      return TREND_NONE;


   //===============================================================
   // HIGH LEBIH BARU
   // Berarti leg bullish
   // Area retracement = BUY
   //===============================================================

   if(highTime > lowTime)
   {
      return TREND_UP;
   }


   //===============================================================
   // LOW LEBIH BARU
   // Berarti leg bearish
   // Area retracement = SELL
   //===============================================================

   if(lowTime > highTime)
   {
      return TREND_DOWN;
   }


   return TREND_NONE;
}


//==================================================================//
// HITUNG HARGA FIBONACCI
//==================================================================//

double FibPrice(
   ZoneTrend trend,
   double swingHigh,
   double swingLow,
   double level
)
{
   double range =
      swingHigh - swingLow;


   if(range <= 0)
      return 0;


   //===============================================================
   // BUY
   //
   // Fib 0       = Swing High
   // Fib 0.236   = turun
   // Fib 0.382   = turun
   // Fib 0.618   = turun
   // Fib 0.786   = turun
   // Fib -0.272  = naik di atas Swing High
   //===============================================================

   if(trend == TREND_UP)
   {
      return
         swingHigh -
         (range * level);
   }


   //===============================================================
   // SELL
   //
   // Fib 0       = Swing Low
   // Fib 0.236   = naik
   // Fib 0.382   = naik
   // Fib 0.618   = naik
   // Fib 0.786   = naik
   // Fib -0.272  = turun di bawah Swing Low
   //===============================================================

   if(trend == TREND_DOWN)
   {
      return
         swingLow +
         (range * level);
   }


   return 0;
}


//==================================================================//
// HITUNG ZONA
//==================================================================//

void GetZone(
   ZoneTrend trend,
   double swingHigh,
   double swingLow,
   double levelStart,
   double levelEnd,
   double &zoneLow,
   double &zoneHigh
)
{
   double price1 =
      FibPrice(
         trend,
         swingHigh,
         swingLow,
         levelStart
      );


   double price2 =
      FibPrice(
         trend,
         swingHigh,
         swingLow,
         levelEnd
      );


   zoneLow =
      MathMin(
         price1,
         price2
      );


   zoneHigh =
      MathMax(
         price1,
         price2
      );
}


//==================================================================//
// CEK HARGA DI DALAM ZONE
//==================================================================//

bool PriceInZone(
   double price,
   double zoneLow,
   double zoneHigh
)
{
   return
      price >= zoneLow &&
      price <= zoneHigh;
}


//==================================================================//
// REJECTION M15
//
// SHIFT 1 = candle M15 terakhir yang SUDAH CLOSE
//==================================================================//

bool CheckRejectionM15(
   bool forBuy,
   double zoneLow,
   double zoneHigh,
   datetime &rejectionTime
)
{
   int shift = 1;


   datetime candleTime =
      iTime(
         _Symbol,
         RejectionTF,
         shift
      );


   if(candleTime <= 0)
      return false;


   double open =
      iOpen(
         _Symbol,
         RejectionTF,
         shift
      );


   double close =
      iClose(
         _Symbol,
         RejectionTF,
         shift
      );


   double high =
      iHigh(
         _Symbol,
         RejectionTF,
         shift
      );


   double low =
      iLow(
         _Symbol,
         RejectionTF,
         shift
      );


   double range =
      high - low;


   if(range <= 0)
      return false;


   //===============================================================
   // CANDLE HARUS MENYENTUH ZONE
   //===============================================================

   bool touchesZone =
      high >= zoneLow &&
      low <= zoneHigh;


   if(!touchesZone)
      return false;


   double lowerWick =
      MathMin(open, close) - low;


   double upperWick =
      high - MathMax(open, close);


   //===============================================================
   // BUY REJECTION
   //
   // Candle bullish
   // Lower wick dominan
   // Close berada di bagian atas candle
   //===============================================================

   if(forBuy)
   {
      bool bullish =
         close > open;


      bool lowerWickStrong =
         (lowerWick / range)
         >= RejectionWickRatio;


      bool closeStrong =
         close >
         (low + range * 0.50);


      if(
         bullish &&
         lowerWickStrong &&
         closeStrong
      )
      {
         rejectionTime =
            candleTime;

         return true;
      }
   }


   //===============================================================
   // SELL REJECTION
   //
   // Candle bearish
   // Upper wick dominan
   // Close berada di bagian bawah candle
   //===============================================================

   if(!forBuy)
   {
      bool bearish =
         close < open;


      bool upperWickStrong =
         (upperWick / range)
         >= RejectionWickRatio;


      bool closeStrong =
         close <
         (low + range * 0.50);


      if(
         bearish &&
         upperWickStrong &&
         closeStrong
      )
      {
         rejectionTime =
            candleTime;

         return true;
      }
   }


   return false;
}


//==================================================================//
// VALIDASI SL
//==================================================================//

bool IsValidSLDistance(
   ENUM_ORDER_TYPE orderType,
   double sl
)
{
   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );


   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK
      );


   long stopsLevel =
      SymbolInfoInteger(
         _Symbol,
         SYMBOL_TRADE_STOPS_LEVEL
      );


   double minimumDistance =
      stopsLevel * _Point;


   if(orderType == ORDER_TYPE_BUY)
   {
      if(sl >= bid)
         return false;


      if(
         bid - sl
         < minimumDistance
      )
      {
         return false;
      }
   }


   if(orderType == ORDER_TYPE_SELL)
   {
      if(sl <= ask)
         return false;


      if(
         sl - ask
         < minimumDistance
      )
      {
         return false;
      }
   }


   return true;
}


//==================================================================//
// FILLING MODE BROKER
//==================================================================//

ENUM_ORDER_TYPE_FILLING GetFillingMode()
{
   int filling =
      (int)SymbolInfoInteger(
         _Symbol,
         SYMBOL_FILLING_MODE
      );


   if(
      (filling & SYMBOL_FILLING_FOK)
      == SYMBOL_FILLING_FOK
   )
   {
      return ORDER_FILLING_FOK;
   }


   if(
      (filling & SYMBOL_FILLING_IOC)
      == SYMBOL_FILLING_IOC
   )
   {
      return ORDER_FILLING_IOC;
   }


   return ORDER_FILLING_RETURN;
}


