//==================================================================//
// MODIFY SL
//==================================================================//

bool ModifySL(
   ulong ticket,
   double newSL
)
{
   if(
      !PositionSelectByTicket(ticket)
   )
   {
      return false;
   }


   MqlTradeRequest request;

   MqlTradeResult result;


   ZeroMemory(request);

   ZeroMemory(result);


   request.action =
      TRADE_ACTION_SLTP;


   request.position =
      ticket;


   request.symbol =
      _Symbol;


   request.sl =
      NormalizeDouble(
         newSL,
         _Digits
      );


   request.tp = 0;


   ResetLastError();


   if(
      !OrderSend(
         request,
         result
      )
   )
   {
      Print(
         "Modify SL gagal | Error = ",
         GetLastError()
      );

      return false;
   }


   if(
      result.retcode !=
      TRADE_RETCODE_DONE
   )
   {
      Print(
         "Modify SL ditolak | Retcode = ",
         result.retcode
      );

      return false;
   }


   return true;
}


//==================================================================//
// CLOSE POSITION
//==================================================================//

bool ClosePosition(
   ulong ticket
)
{
   if(
      !PositionSelectByTicket(ticket)
   )
   {
      return false;
   }


   long positionType =
      PositionGetInteger(
         POSITION_TYPE
      );


   double volume =
      PositionGetDouble(
         POSITION_VOLUME
      );


   MqlTradeRequest request;

   MqlTradeResult result;


   ZeroMemory(request);

   ZeroMemory(result);


   request.action =
      TRADE_ACTION_DEAL;


   request.position =
      ticket;


   request.symbol =
      _Symbol;


   request.volume =
      volume;


   request.magic =
      MagicNumber;


   request.deviation =
      Slippage;


   request.type_filling =
      GetFillingMode();


   if(
      positionType ==
      POSITION_TYPE_BUY
   )
   {
      request.type =
         ORDER_TYPE_SELL;


      request.price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID
         );
   }
   else
   {
      request.type =
         ORDER_TYPE_BUY;


      request.price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_ASK
         );
   }


   ResetLastError();


   if(
      !OrderSend(
         request,
         result
      )
   )
   {
      Print(
         "Close posisi gagal | Error = ",
         GetLastError()
      );

      return false;
   }


   if(
      result.retcode !=
      TRADE_RETCODE_DONE
   )
   {
      Print(
         "Close posisi ditolak | Retcode = ",
         result.retcode
      );

      return false;
   }


   return true;
}


//==================================================================//
// KELOLA TP1 / TP2 / TRAILING
//==================================================================//

void ManageTrade()
{
   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);


      if(ticket == 0)
         continue;


      if(
         !PositionSelectByTicket(ticket)
      )
         continue;


      if(
         PositionGetString(
            POSITION_SYMBOL
         )
         != _Symbol
      )
         continue;


      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         )
         != MagicNumber
      )
         continue;


      long positionType =
         PositionGetInteger(
            POSITION_TYPE
         );


      double bid =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID
         );


      double ask =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_ASK
         );


      double currentSL =
         PositionGetDouble(
            POSITION_SL
         );


      //============================================================
      // Pastikan data trade tersedia
      //============================================================

      if(!ActiveTrade.valid)
      {
         continue;
      }


      //============================================================
      // BUY
      //============================================================

      if(
         positionType ==
         POSITION_TYPE_BUY
      )
      {
         //=========================================================
         // TP1 TERSENTUH
         //=========================================================

         if(
            !ActiveTrade.tp1Reached &&
            bid >= ActiveTrade.tp1
         )
         {
            ActiveTrade.tp1Reached = true;


            Print(
               "BUY mencapai TP1 Fib 0."
            );

            Print(
               "Trailing $",
               TP1TrailingDistanceUSD,
               " AKTIF."
            );
         }


         //=========================================================
         // TP2
         //=========================================================

         if(
            bid >= ActiveTrade.tp2
         )
         {
            Print(
               "BUY mencapai TP2 Fib -0.272."
            );


            if(
               ClosePosition(ticket)
            )
            {
               ResetTradeData();
            }


            continue;
         }


         //=========================================================
         // TRAILING SETELAH TP1
         //=========================================================

         if(
            UseTP1Trailing &&
            ActiveTrade.tp1Reached
         )
         {
            double newSL =
               bid -
               TP1TrailingDistanceUSD;


            newSL =
               NormalizeDouble(
                  newSL,
                  _Digits
               );


            if(
               newSL > currentSL &&
               newSL < bid
            )
            {
               if(
                  IsValidSLDistance(
                     ORDER_TYPE_BUY,
                     newSL
                  )
               )
               {
                  if(
                     ModifySL(
                        ticket,
                        newSL
                     )
                  )
                  {
                     Print(
                        "BUY TRAILING SL = ",
                        newSL
                     );
                  }
               }
            }
         }
      }


      //============================================================
      // SELL
      //============================================================

      if(
         positionType ==
         POSITION_TYPE_SELL
      )
      {
         //=========================================================
         // TP1 TERSENTUH
         //=========================================================

         if(
            !ActiveTrade.tp1Reached &&
            ask <= ActiveTrade.tp1
         )
         {
            ActiveTrade.tp1Reached = true;


            Print(
               "SELL mencapai TP1 Fib 0."
            );

            Print(
               "Trailing $",
               TP1TrailingDistanceUSD,
               " AKTIF."
            );
         }


         //=========================================================
         // TP2
         //=========================================================

         if(
            ask <= ActiveTrade.tp2
         )
         {
            Print(
               "SELL mencapai TP2 Fib -0.272."
            );


            if(
               ClosePosition(ticket)
            )
            {
               ResetTradeData();
            }


            continue;
         }


         //=========================================================
         // TRAILING SETELAH TP1
         //=========================================================

         if(
            UseTP1Trailing &&
            ActiveTrade.tp1Reached
         )
         {
            double newSL =
               ask +
               TP1TrailingDistanceUSD;


            newSL =
               NormalizeDouble(
                  newSL,
                  _Digits
               );


            if(
               (
                  currentSL == 0 ||
                  newSL < currentSL
               )
               &&
               newSL > ask
            )
            {
               if(
                  IsValidSLDistance(
                     ORDER_TYPE_SELL,
                     newSL
                  )
               )
               {
                  if(
                     ModifySL(
                        ticket,
                        newSL
                     )
                  )
                  {
                     Print(
                        "SELL TRAILING SL = ",
                        newSL
                     );
                  }
               }
            }
         }
      }
   }
}


//==================================================================//
// CEK API START / STOP
//==================================================================//

void CheckApiStatus()
{
   if(
      ApiStatusUrl == ""
   )
   {
      return;
   }


   if(
      TimeCurrent() - LastApiCheck
      < ApiCheckSeconds
   )
   {
      return;
   }


   LastApiCheck =
      TimeCurrent();


   string headers = "";

   char postData[];

   char result[];

   string resultHeaders;


   ResetLastError();


   int responseCode =
      WebRequest(
         "GET",
         ApiStatusUrl,
         headers,
         5000,
         postData,
         result,
         resultHeaders
      );


   if(responseCode == -1)
   {
      Print(
         "API ERROR = ",
         GetLastError()
      );

      return;
   }


   string response =
      CharArrayToString(
         result
      );


   Print(
      "API STATUS = ",
      response
   );


   //===============================================================
   // RUNNING
   //===============================================================

   if(
      StringFind(
         response,
         "\"status\":\"RUNNING\""
      ) >= 0
      ||
      StringFind(
         response,
         "\"running\":true"
      ) >= 0
      ||
      StringFind(
         response,
         "\"running\": true"
      ) >= 0
   )
   {
      BotEnabled = true;

      return;
   }


   //===============================================================
   // STOPPED
   //===============================================================

   if(
      StringFind(
         response,
         "\"status\":\"STOPPED\""
      ) >= 0
      ||
      StringFind(
         response,
         "\"running\":false"
      ) >= 0
      ||
      StringFind(
         response,
         "\"running\": false"
      ) >= 0
   )
   {
      BotEnabled = false;

      return;
   }


   Print(
      "API response tidak dikenali."
   );
}


