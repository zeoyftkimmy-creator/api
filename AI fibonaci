//==================================================================//
// TICK
//==================================================================//
void OnTick()
{
   //===============================================================
   // API
   //===============================================================
   CheckApiStatus();

   //===============================================================
   // MANAGE POSISI YANG SUDAH TERBUKA
   //===============================================================
   if(CountOpenPositions() > 0)
   {
      ManageActiveTrade();
      return;
   }

   // Kalau posisi sudah tidak ada
   if(ActiveTrade.valid)
      ResetTradeData();

   //===============================================================
   // API STOP
   //===============================================================
   if(!BotEnabled)
      return;

   //===============================================================
   // ENTRY HANYA PADA BAR M5 BARU
   //===============================================================
   if(!IsNewEntryBar())
      return;

   //===============================================================
   // MAKSIMAL 1 POSISI
   //===============================================================
   if(CountOpenPositions() >= 1)
      return;

   //===============================================================
   // SWING M30
   //===============================================================
   double swingHigh;
   double swingLow;

   datetime highTime;
   datetime lowTime;

   ZoneTrend trend =
      GetSwingTrend(
         swingHigh,
         swingLow,
         highTime,
         lowTime
      );

   if(trend == TREND_NONE)
      return;

   //===============================================================
   // ZONE 1
   //===============================================================
   double z1Low;
   double z1High;

   GetZone(
      trend,
      swingHigh,
      swingLow,
      Zone1Start,
      Zone1End,
      z1Low,
      z1High
   );

   //===============================================================
   // ZONE 2
   //===============================================================
   double z2Low;
   double z2High;

   GetZone(
      trend,
      swingHigh,
      swingLow,
      Zone2Start,
      Zone2End,
      z2Low,
      z2High
   );

   double price =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );

   //===============================================================
   // BUY
   //===============================================================
   if(trend == TREND_UP)
   {
      bool inZone1 =
         PriceInZone(
            price,
            z1Low,
            z1High
         );

      bool inZone2 =
         PriceInZone(
            price,
            z2Low,
            z2High
         );

      //============================================================
      // BUY ZONE 1
      //============================================================
      if(inZone1)
      {
         datetime rejectionTime = 0;

         if(
            HasRejection(
               true,
               z1Low,
               z1High,
               rejectionTime
            )
         )
         {
            LastRejectionBar =
               rejectionTime;

            OpenBuy(
               swingHigh,
               swingLow
            );
         }

         return;
      }

      //============================================================
      // BUY ZONE 2
      //============================================================
      if(inZone2)
      {
         datetime rejectionTime = 0;

         if(
            HasRejection(
               true,
               z2Low,
               z2High,
               rejectionTime
            )
         )
         {
            LastRejectionBar =
               rejectionTime;

            OpenBuy(
               swingHigh,
               swingLow
            );
         }

         return;
      }
   }

   //===============================================================
   // SELL
   //===============================================================
   if(trend == TREND_DOWN)
   {
      bool inZone1 =
         PriceInZone(
            price,
            z1Low,
            z1High
         );

      bool inZone2 =
         PriceInZone(
            price,
            z2Low,
            z2High
         );

      //============================================================
      // SELL ZONE 1
      //============================================================
      if(inZone1)
      {
         datetime rejectionTime = 0;

         if(
            HasRejection(
               false,
               z1Low,
               z1High,
               rejectionTime
            )
         )
         {
            LastRejectionBar =
               rejectionTime;

            OpenSell(
               swingHigh,
               swingLow
            );
         }

         return;
      }

      //============================================================
      // SELL ZONE 2
      //============================================================
      if(inZone2)
      {
         datetime rejectionTime = 0;

         if(
            HasRejection(
               false,
               z2Low,
               z2High,
               rejectionTime
            )
         )
         {
            LastRejectionBar =
               rejectionTime;

            OpenSell(
               swingHigh,
               swingLow
            );
         }

         return;
      }
   }
}
