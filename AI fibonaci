//==================================================================//
// CLOSE POSITION
//==================================================================//
bool ClosePosition(
   ulong ticket
)
{
   if(!PositionSelectByTicket(ticket))
      return false;

   long type =
      PositionGetInteger(
         POSITION_TYPE
      );

   double volume =
      PositionGetDouble(
         POSITION_VOLUME
      );

   double price;

   ENUM_ORDER_TYPE orderType;

   if(type == POSITION_TYPE_BUY)
   {
      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID
         );

      orderType =
         ORDER_TYPE_SELL;
   }
   else
   {
      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_ASK
         );

      orderType =
         ORDER_TYPE_BUY;
   }

   MqlTradeRequest request;
   MqlTradeResult result;

   ZeroMemory(request);
   ZeroMemory(result);

   request.action =
      TRADE_ACTION_DEAL;

   request.position =
      ticket;

   request.symbol =
      _Symbol;

   request.volume =
      volume;

   request.type =
      orderType;

   request.price =
      price;

   request.deviation =
      Slippage;

   request.magic =
      MagicNumber;

   request.type_filling =
      GetFillingMode();

   ResetLastError();

   if(!OrderSend(
      request,
      result
   ))
   {
      Print(
         "Close position gagal. Error = ",
         GetLastError()
      );

      return false;
   }

   if(
      result.retcode ==
      TRADE_RETCODE_DONE
   )
   {
      Print(
         "POSITION CLOSED | TP2 / EXIT"
      );

      return true;
   }

   Print(
      "Close ditolak. Retcode = ",
      result.retcode
   );

   return false;
}

//==================================================================//
// TP1 + TP2 + TRAILING
//==================================================================//
void ManageActiveTrade()
{
   if(!ActiveTrade.valid)
      return;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(
         POSITION_SYMBOL)
         != _Symbol)
         continue;

      if((ulong)PositionGetInteger(
         POSITION_MAGIC)
         != MagicNumber)
         continue;

      long type =
         PositionGetInteger(
            POSITION_TYPE
         );

      double bid =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID
         );

      double ask =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_ASK
         );

      //============================================================
      // BUY
      //============================================================
      if(type == POSITION_TYPE_BUY)
      {
         // TP2
         if(bid >= ActiveTrade.tp2)
         {
            ClosePosition(ticket);

            ResetTradeData();

            return;
         }

         // TP1 tercapai
         if(
            !ActiveTrade.tp1Reached &&
            bid >= ActiveTrade.tp1
         )
         {
            ActiveTrade.tp1Reached = true;

            Print(
               "BUY mencapai TP1 FIBO 0."
            );

            Print(
               "Trailing $",
               TP1TrailingDistanceUSD,
               " AKTIF."
            );
         }

         // Trailing hanya setelah TP1
         if(
            ActiveTrade.tp1Reached &&
            UseTP1Trailing
         )
         {
            double newSL =
               NormalizeDouble(
                  bid -
                  TP1TrailingDistanceUSD,
                  _Digits
               );

            double oldSL =
               PositionGetDouble(
                  POSITION_SL
               );

            if(
               IsValidSLDistance(
                  ORDER_TYPE_BUY,
                  newSL
               )
            )
            {
               if(
                  oldSL == 0 ||
                  newSL > oldSL
               )
               {
                  ModifySL(
                     ticket,
                     newSL
                  );
               }
            }
         }
      }

      //============================================================
      // SELL
      //============================================================
      if(type == POSITION_TYPE_SELL)
      {
         // TP2
         if(ask <= ActiveTrade.tp2)
         {
            ClosePosition(ticket);

            ResetTradeData();

            return;
         }

         // TP1
         if(
            !ActiveTrade.tp1Reached &&
            ask <= ActiveTrade.tp1
         )
         {
            ActiveTrade.tp1Reached = true;

            Print(
               "SELL mencapai TP1 FIBO 0."
            );

            Print(
               "Trailing $",
               TP1TrailingDistanceUSD,
               " AKTIF."
            );
         }

         // Trailing setelah TP1
         if(
            ActiveTrade.tp1Reached &&
            UseTP1Trailing
         )
         {
            double newSL =
               NormalizeDouble(
                  ask +
                  TP1TrailingDistanceUSD,
                  _Digits
               );

            double oldSL =
               PositionGetDouble(
                  POSITION_SL
               );

            if(
               IsValidSLDistance(
                  ORDER_TYPE_SELL,
                  newSL
               )
            )
            {
               if(
                  oldSL == 0 ||
                  newSL < oldSL
               )
               {
                  ModifySL(
                     ticket,
                     newSL
                  );
               }
            }
         }
      }
   }
}

//==================================================================//
// MODIFY SL
//==================================================================//
void ModifySL(
   ulong ticket,
   double newSL
)
{
   if(!PositionSelectByTicket(ticket))
      return;

   MqlTradeRequest request;
   MqlTradeResult result;

   ZeroMemory(request);
   ZeroMemory(result);

   request.action =
      TRADE_ACTION_SLTP;

   request.position =
      ticket;

   request.symbol =
      _Symbol;

   request.sl =
      newSL;

   request.tp =
      PositionGetDouble(
         POSITION_TP
      );

   ResetLastError();

   if(!OrderSend(
      request,
      result
   ))
   {
      Print(
         "Modify SL gagal | Error = ",
         GetLastError()
      );
   }
}

//==================================================================//
// API
//==================================================================//
void CheckApiStatus()
{
   if(ApiStatusUrl == "")
      return;

   if(
      TimeCurrent() -
      LastApiCheck <
      ApiCheckSeconds
   )
      return;

   LastApiCheck =
      TimeCurrent();

   string headers = "";

   char postData[];
   char result[];

   string resultHeaders;

   ResetLastError();

   int response =
      WebRequest(
         "GET",
         ApiStatusUrl,
         headers,
         5000,
         postData,
         result,
         resultHeaders
      );

   if(response == -1)
   {
      Print(
         "API gagal | Error = ",
         GetLastError()
      );

      return;
   }

   string text =
      CharArrayToString(
         result
      );

   if(
      StringFind(
         text,
         "\"status\":\"RUNNING\""
      ) >= 0
   )
   {
      BotEnabled = true;
      return;
   }

   if(
      StringFind(
         text,
         "\"status\":\"STOPPED\""
      ) >= 0
   )
   {
      BotEnabled = false;
      return;
   }

   Print(
      "API response tidak dikenali: ",
      text
   );
}

